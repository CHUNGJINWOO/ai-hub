                    FROM projects
                    WHERE id = %s;
                    """,
                    (memory.project_id,),
                ).fetchone()

                if project is None:
                    raise HTTPException(
                        status_code=404,
                        detail="Project not found",
                    )

            result = conn.execute(
                """
                INSERT INTO memories (
                    content,
                    memory_type,
                    category,
                    importance,
                    source,
                    embedding,
                    project_id
                )
                VALUES (%s, %s, %s, %s, %s, %s, %s)
                RETURNING id;
                """,
