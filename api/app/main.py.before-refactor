            raise HTTPException(
                status_code=400,
                detail="Invalid project status",
            )

        with get_db_connection() as conn:
            existing = conn.execute(
                """
                SELECT id
                FROM projects
                WHERE slug = %s;
                """,
                (project.slug,),
            ).fetchone()

            if existing is not None:
                raise HTTPException(
                    status_code=409,
                    detail="Project slug already exists",
                )

            row = conn.execute(
                """
                INSERT INTO projects (
                    name,
                    slug,
                    description,
                    status
                )
                VALUES (%s, %s, %s, %s)
                RETURNING
                    id,
                    name,
                    slug,
                    description,
                    status,
                    created_at,
                    updated_at;
                """,
                (
                    project.name,
                    project.slug,
                    project.description,
                    project.status,
                ),
            ).fetchone()

            conn.commit()

        return {
            "id": row[0],
